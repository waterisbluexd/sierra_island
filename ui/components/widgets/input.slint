import { Theme } from "../../theme_cont/theme.slint";
import { SearchNavigation } from "../state.slint";
import "../../../res/fonts/FFFFORWA.ttf";


export { Theme }

export component Input inherits VerticalLayout {
    in property <string> text-font: "FFF Forward";
    in property <length> text-size: 10px;
    in property <length> row-height: text-size * 1.8;

    in-out property <[string]> results: [];
    callback input-changed(string);
    callback clear-input;

    alignment: start;
    spacing: 4px;
    padding-top: 9px;
    forward-focus: input;
    width: input-row.preferred-width;

    property <int> visible-row-count:
        max(0, min(7, root.results.length - SearchNavigation.window-start));

    property <length> results-content-height: visible-row-count > 0
        ? visible-row-count * root.row-height + (visible-row-count - 1) * 4px + 8px
        : 0px;

    property <int> _clear-token-ack: 0;

    input-row := HorizontalLayout {
        spacing: 7px;
        alignment: start;

        Text {
            text: ">";
            color: Theme.foreground;
            font-family: root.text-font;
            font-size: root.text-size;
            height: root.row-height;
            vertical-alignment: center;
        }

        input := TextInput {
            width: 120px;
            height: root.row-height;
            color: Theme.foreground;
            font-family: root.text-font;
            font-size: root.text-size;
            vertical-alignment: center;
            horizontal-alignment: left;
            text: SearchNavigation.clear-token != _clear-token-ack ? "" : SearchNavigation.search-text;
            edited => {
                _clear-token-ack = SearchNavigation.clear-token;
                SearchNavigation.search-text = self.text;
                root.input-changed(self.text);
                SearchNavigation.selected-index = -1;
            }
        }
    }

    clear-input => {
        input.text = "";
        _clear-token-ack = SearchNavigation.clear-token;
        SearchNavigation.search-text = "";
        root.results = [];
        SearchNavigation.selected-index = -1;
        SearchNavigation.window-start = 0;
        SearchNavigation.selected-result = "";
    }

    results-list := VerticalLayout {
        width: parent.width;
        height: root.results-content-height;
        spacing: 4px;
        padding-bottom: 8px;

        for offset in [0, 1, 2, 3, 4, 5, 6] : result-row := Rectangle {
            visible: root.results.length > 0 && SearchNavigation.window-start + offset < root.results.length;
            width: parent.width;
            height: root.row-height;
            background: root.results.length > 0
                && SearchNavigation.window-start + offset < root.results.length
                && root.results[SearchNavigation.window-start + offset] == SearchNavigation.selected-result
                ? Theme.color3
                : transparent;

            Text {
                visible: root.results.length > 0 && SearchNavigation.window-start + offset < root.results.length;
                text: root.results.length > 0
                    && SearchNavigation.window-start + offset < root.results.length
                    ? root.results[SearchNavigation.window-start + offset]
                    : "";
                color: root.results.length > 0
                    && SearchNavigation.window-start + offset < root.results.length
                    && root.results[SearchNavigation.window-start + offset] == SearchNavigation.selected-result
                    ? Theme.background
                    : Theme.foreground;
                font-family: root.text-font;
                font-size: root.text-size;
                height: root.row-height;
                vertical-alignment: center;
                horizontal-alignment: left;
                x: 4px;
                width: parent.width - 8px;
            }
        }
    }

    initial-focus-timer := Timer {
        interval: 50ms;
        running: true;
        triggered() => {
            input.focus();
            initial-focus-timer.running = false;
        }
    }
}
