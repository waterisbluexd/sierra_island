import { Theme } from "../../theme_cont/theme.slint";
import "../../../res/fonts/FFFFORWA.ttf";


export { Theme }

export component Input inherits HorizontalLayout {
    spacing: 3px;
    alignment: start;
    forward-focus: input;

    callback input-changed(string);

    Text {
        text: ">";
        color: Theme.foreground;
        font-family: "FFF Forward";
        font-size: 10px;
        vertical-alignment: center;
        horizontal-alignment: left;
    }

    input := TextInput {
        width: 120px;
        color: Theme.foreground;
        font-family: "FFF Forward";
        font-size: 10px;
        vertical-alignment: center;
        horizontal-alignment: left;
        y: 1px;
        edited => {
            root.input-changed(self.text);
        }
    }

    initial-focus-timer := Timer {
        interval: 50ms;
        running: true;
        triggered() => {
            input.focus();
            initial-focus-timer.running = false;
        }
    }
}

