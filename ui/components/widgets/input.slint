import { Theme } from "../../theme_cont/theme.slint";
import "../../../res/fonts/FFFFORWA.ttf";


export { Theme }

export component Input inherits VerticalLayout {
    alignment: start;
    spacing: 0px;
    forward-focus: input;
    padding-top: 13px;
    callback input-changed(string);

    in-out property <[string]> results: [];

    input-row := HorizontalLayout {
        spacing: 7px;
        alignment: start;

        Text {
            text: ">";
            color: Theme.foreground;
            font-family: "FFF Forward";
            font-size: 10px;
            vertical-alignment: center;
            horizontal-alignment: left;
        }

        input := TextInput {
            width: 120px;
            color: Theme.foreground;
            font-family: "FFF Forward";
            font-size: 10px;
            vertical-alignment: center;
            horizontal-alignment: left;
            edited => {
                root.input-changed(self.text);
            }
        }
    }

    results-list := VerticalLayout {
        spacing: 4px;

        for result in root.results : Text {
            text: result;
            color: Theme.foreground;
            font-family: "FFF Forward";
            font-size: 10px;
            vertical-alignment: top;
            horizontal-alignment: left;
        }
    }

    initial-focus-timer := Timer {
        interval: 50ms;
        running: true;
        triggered() => {
            input.focus();
            initial-focus-timer.running = false;
        }
    }
}
