import { Theme } from "../../theme_cont/theme.slint";
import "../../../res/fonts/FFFFORWA.ttf";

export { Theme }

export component Input inherits HorizontalLayout {
    width: 100%;
    height: 36px;
    spacing: 3px;
    alignment: start;
    forward-focus: input;

    Text {
        text: ">";
        color: Theme.foreground;
        font-family: "FFF Forward";
        font-size: 10px;
        vertical-alignment: center;
        horizontal-alignment: left;
    }

    input := TextInput {
        horizontal-stretch: 1;
        color: Theme.foreground;
        font-family: "FFF Forward";
        font-size: 10px;
        vertical-alignment: center;
        horizontal-alignment: left;
    }

    initial-focus-timer := Timer {
        interval: 50ms;
        running: true;
        triggered() => {
            input.focus();
            initial-focus-timer.running = false;
        }
    }
}

