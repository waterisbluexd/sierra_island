import { Theme } from "../../theme_cont/theme.slint";
import { SearchNavigation } from "../state.slint";
import "../../../res/fonts/FFFFORWA.ttf";


export { Theme }

export component Input inherits VerticalLayout {
    in property <string> text-font: "FFF Forward";
    in property <length> text-size: 10px;
    in property <length> row-height: text-size * 1.8;

    in-out property <[string]> results: [];
    callback input-changed(string);

    alignment: start;
    spacing: 4px;
    padding-top: 9px;
    forward-focus: input;
    width: input-row.preferred-width;

    property <length> results-content-height: root.results.length > 0
        ? root.results.length * root.row-height + (root.results.length - 1) * 4px
        : 0px;

    input-row := HorizontalLayout {
        spacing: 7px;
        alignment: start;

        Text {
            text: ">";
            color: Theme.foreground;
            font-family: root.text-font;
            font-size: root.text-size;
            height: root.row-height;
            vertical-alignment: center;
        }

        input := TextInput {
            width: 120px;
            height: root.row-height;
            color: Theme.foreground;
            font-family: root.text-font;
            font-size: root.text-size;
            vertical-alignment: center;
            horizontal-alignment: left;
            edited => {
                root.input-changed(self.text);
                SearchNavigation.selected-index = -1;
            }
        }
    }

    results-list := VerticalLayout {
        width: parent.width;
        height: root.results-content-height;
        spacing: 4px;

        for result in root.results : result-row := Rectangle {
            width: parent.width;
            height: root.row-height;
            background: result == SearchNavigation.selected-result
                ? Theme.color3
                : transparent;

            Text {
                text: result;
                color: result == SearchNavigation.selected-result
                    ? Theme.background
                    : Theme.foreground;
                font-family: root.text-font;
                font-size: root.text-size;
                height: root.row-height;
                vertical-alignment: center;
                horizontal-alignment: left;
                x: 4px;
                width: parent.width - 8px;
            }
        }
    }

    initial-focus-timer := Timer {
        interval: 50ms;
        running: true;
        triggered() => {
            input.focus();
            initial-focus-timer.running = false;
        }
    }
}
