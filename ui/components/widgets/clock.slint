import { Theme } from "../../theme_cont/theme.slint";
import { ClockState } from "../state.slint";
import "../../../res/fonts/ttyclock.ttf";
import "../../../res/fonts/FFFFORWA.ttf";

export { Theme }

export component Clock inherits HorizontalLayout {
    in property <bool> show-seconds: true;
    in property <bool> is-24-hour: true;
    in property <bool> show-am-pm: true;

    spacing: 3px;

    pure function format-hour() -> int {
        if (is-24-hour) {
            return ClockState.hour;
        }

        let h = Math.mod(ClockState.hour, 12);
        return h == 0 ? 12 : h;
    }

    pure function suffix() -> string {
        if (!show-am-pm || is-24-hour) {
            return "";
        }

        return ClockState.hour < 12 ? "Am" : "Pm";
    }

    ///////////////////////////////////////-Clock Num-///////////////////////////////////////
    Text {
        text: "\{root.format-hour()}:\{ClockState.minute < 10 ? "0" : ""}\{ClockState.minute}\{root.show-seconds ? ":" + (ClockState.seconds < 10 ? "0" : "") + ClockState.seconds : ""}";
        color: Theme.color12;
        font-family: "ttyclock";
        font-size: 13px;

        vertical-alignment: center;
    }

    ///////////////////////////////////////-Clock Am?Pm-/////////////////////////////////////
    Text {
        text: root.suffix();
        color: Theme.color12;
        font-family: "FFF Forward";
        font-size: 10px;

        vertical-alignment: center;
        y: 2px;

        visible: root.show-am-pm && !root.is-24-hour;
    }
}
