import { Theme } from "../theme_cont/theme.slint";
import { Clock } from "./widgets/clock.slint";
import "../../res/fonts/ttyclock.ttf";

export component IslandContainer inherits Rectangle {
    in property <string> current-time;

    width: 250px;
    height: 36px;

    background: Theme.color0;
    border-radius: 8px;
    border-width: 0px;

    Clock {
        time: current-time;
    }
}
