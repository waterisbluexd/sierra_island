import { ContainerConfig } from "./models.slint";
import { WidgetSlot } from "./WidgetSlot.slint";

export component IslandContainer inherits Rectangle {
    in property <ContainerConfig> config;

    in-out property <[string]> search-results: [];

    callback input-changed(string);
    callback clear-input;

    background: transparent;

    border-width: 0px;
    border-radius: 0px;

    layout := HorizontalLayout {
        alignment: center;

        padding-left: 20px;
        padding-right: 20px;

        spacing: 20px;

        for slot in root.config.slots : WidgetSlot {
            widgets: slot.widgets;
            search-results: root.search-results;

            input-changed(query) => { root.input-changed(query); }
            clear-input => { root.clear-input(); }
        }
    }

    width: layout.preferred-width + 22px < 150px
        ? 150px
        : layout.preferred-width + 22px;

    height: max(36px, min(layout.preferred-height, 200px));
}
