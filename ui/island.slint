import { ContainerPager } from "./components/ContainerPager.slint";
import { ClockState, DateState, ContainerState } from "./components/state.slint";
import { Theme } from "./theme_cont/theme.slint";

export { Theme, ClockState, DateState, ContainerState }

export component Island inherits Window {
    background: transparent;

    in property <bool> visible-requested: false;

    out property <bool> hovered: area.has-hover;

    out property <length> content-width: pager.width;
    out property <length> content-height: pager.height + 2px;

    area := TouchArea {
        width: parent.width;
        height: parent.height;

        pager := ContainerPager {
            x: (parent.width - self.width) / 2;
            y: root.visible-requested ? 2px : -self.height;

            opacity: root.visible-requested ? 1 : 0;

            animate y {
                duration: 220ms;
                easing: ease-out;
            }

            animate opacity {
                duration: 180ms;
            }
        }
    }
}
